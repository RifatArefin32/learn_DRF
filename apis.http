# Install REST Client extension in VS code
# Create a file with .http extension and test the endpoints

### Variables ###
@localhost = http://127.0.0.1:8000

### Show all products
GET {{localhost}}/core/products/ HTTP/1.1
Content-Type: application/json 

### Show all products with query parameters     
GET {{localhost}}/core/products/?min_price=10&max_price=50&min_stock=5 HTTP/1.1
Content-Type: application/json 

### Create a new product
POST {{localhost}}/core/products/ HTTP/1.1
Content-Type: application/json

{   
    "name": "New Product 4",
    "description": "This is a new product 4",
    "price": 49.99,
    "stock": 20
}

### Show product details
GET {{localhost}}/core/products/1 HTTP/1.1
Content-Type: application/json

### Show all products using shortcut
GET {{localhost}}/core/products/shortcut HTTP/1.1
Content-Type: application/json

### Show product details using shortcut
GET {{localhost}}/core/products/shortcut/100 HTTP/1.1
Content-Type: application/json

### Show product info
GET {{localhost}}/core/product-info/ HTTP/1.1
Content-Type: application/json
Authorization: Basic admin:password

### Create a new product
POST {{localhost}}/core/products/create/ HTTP/1.1
Content-Type: application/json
Authorization: Basic admin:password

{   
    "name": "New Product 3",
    "description": "This is a new product 3",
    "price": 49.99,
    "stock": 20
}

### Show all orders
GET {{localhost}}/core/all-orders/ HTTP/1.1
Content-Type: application/json

### Show all orders with query parameters
GET {{localhost}}/core/all-orders/?status=cancelled HTTP/1.1
Content-Type: application/json
Authorization: Basic admin:password

### Show my orders
GET {{localhost}}/core/my-orders/ HTTP/1.1
Content-Type: application/json
Authorization: Basic admin:password