# Install REST Client extension in VS code
# Create a file with .http extension and test the endpoints

### Variables ###
@localhost = http://127.0.0.1:8000

### Show all products
GET {{localhost}}/core/products/ HTTP/1.1
Content-Type: application/json 

### Show all products with query parameters     
GET {{localhost}}/core/products/?min_price=10&max_price=50&min_stock=5 HTTP/1.1
Content-Type: application/json 

### Show all products with is in stock filter
GET {{localhost}}/core/products/?stock=20 HTTP/1.1
Content-Type: application/json

### Show all products with name filter
GET {{localhost}}/core/products/?name=car HTTP/1.1
Content-Type: application/json

### Show all products with name filter (case-insensitive)
GET {{localhost}}/core/products/?name=Car HTTP/1.1
Content-Type: application/json

### Show all products with name filter (partial match)
GET {{localhost}}/core/products/?name=product HTTP/1.1
Content-Type: application/json

### Show all orders with search query
GET {{localhost}}/core/products/?search=authority HTTP/1.1
Content-Type: application/json
Authorization: Basic admin:password

### Create a new product
POST {{localhost}}/core/products/ HTTP/1.1
Content-Type: application/json
Authorization: Token 6aaddce35a72e80955b134722d6847ab6e2e5455

{   
    "name": "New Product 10",
    "description": "This is a new product 10",
    "price": 49.99,
    "stock": 20
}

### Show product details
GET {{localhost}}/core/products/2/ HTTP/1.1
Content-Type: application/json
Authorization: Basic iward:password123

### Update product details (full update)
PUT {{localhost}}/core/products/2/ HTTP/1.1
Content-Type: application/json
Authorization: Basic iward:password123

{   
    "name": "Updated Product 2",
    "description": "This is an updated product 2",
    "price": 59.99,
    "stock": 25
}

### Update product details (partial update)
PATCH {{localhost}}/core/products/2/ HTTP/1.1
Content-Type: application/json
Authorization: Basic admin:password 

{   
    "price": 39.99
}

### Delete a product
DELETE {{localhost}}/core/products/1/ HTTP/1.1
Content-Type: application/json
Authorization: Basic admin:password 

### Show all products using shortcut
GET {{localhost}}/core/products/shortcut HTTP/1.1
Content-Type: application/json

### Show product details using shortcut
GET {{localhost}}/core/products/shortcut/100 HTTP/1.1
Content-Type: application/json

### Show product info
GET {{localhost}}/core/product-info/ HTTP/1.1
Content-Type: application/json
Authorization: Basic admin:password

### Create a new product
POST {{localhost}}/core/products/create/ HTTP/1.1
Content-Type: application/json
Authorization: Basic admin:password

{   
    "name": "New Product 3",
    "description": "This is a new product 3",
    "price": 49.99,
    "stock": 20
}

### Show all orders
GET {{localhost}}/core/all-orders/ HTTP/1.1
Content-Type: application/json

### Show all orders with query parameters
GET {{localhost}}/core/all-orders/?status=cancelled HTTP/1.1
Content-Type: application/json
Authorization: Basic admin:password

### Show my orders
GET {{localhost}}/core/my-orders/ HTTP/1.1
Content-Type: application/json
Authorization: Basic admin:password

### Get all users   
GET {{localhost}}/account/users/ HTTP/1.1
Content-Type: application/json
Authorization: Basic admin:password

### Login and get token
POST {{localhost}}/account/login/ HTTP/1.1
Content-Type: application/json

{
    "username": "iward",
    "password": "password123"
}

### Get JWT token (Access and Refresh tokens)
POST {{localhost}}/account/api/token/ HTTP/1.1
Content-Type: application/json

{
    "username": "iward",
    "password": "password123"
}

### Validate access token
POST {{localhost}}/account/api/token/verify/ HTTP/1.1
Content-Type: application/json  

{
